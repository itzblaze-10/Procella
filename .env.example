# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# The Procella core needs NO credentials: NASA POWER and the ORNL MODIS service are open.

# Optional, only if the Earthdata-backed stretch sources are added later
# (Giovanni, AppEEARS, GES DISC). Leave empty otherwise.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Optional, only if NOAA CDO is added later.
NOAA_CDO_TOKEN=
